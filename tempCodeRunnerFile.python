import cv2
import threading
from ultralytics import YOLO

# Load YOLO model
model = YOLO("yolov5su.pt")

# Video capture (DroidCam)
cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 320)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 240)

if not cap.isOpened():
    print("Camera not accessible.")
    exit()

# Shared variables between threads
latest_frame = None
annotated_frame = None
lock = threading.Lock()
running = True


def capture_thread():
    """Thread to continuously grab frames from the camera"""
    global latest_frame, running
    while running:
        ret, frame = cap.read()
        if not ret:
            continue
        with lock:
            latest_frame = frame.copy()

def detection_thread():
    """Thread to run YOLO detection on every 3rd frame"""
    global latest_frame, annotated_frame, running
    frame_count = 0
    while running:
        with lock:
            if latest_frame is None:
                continue
            frame = latest_frame.copy()
        frame_count += 1

        if frame_count % 3 == 0:  # Run detection only every 3rd frame
            results = model(frame, stream=True)
            for r in results:
                annotated_frame = r.plot()
        else:
            if annotated_frame is None:
                annotated_frame = frame

# Start threads
t1 = threading.Thread(target=capture_thread, daemon=True)
t2 = threading.Thread(target=detection_thread, daemon=True)
t1.start()
t2.start()

# Main loop: just display
while True:
    if annotated_frame is not None:
        cv2.imshow("YOLO Detection", annotated_frame)

    key = cv2.waitKey(30) & 0xFF
    if key == ord("q"):
        running = False
        break

cap.release()
cv2.destroyAllWindows()